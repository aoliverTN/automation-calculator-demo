<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS option: copy to ~/Library/LaunchAgents/, fix the paths, then
     launchctl load ~/Library/LaunchAgents/com.switchboard.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.switchboard</string>
  <key>ProgramArguments</key>
  <array><string>/opt/homebrew/bin/node</string><string>/Users/YOU/switchboard/src/server.js</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SWITCHBOARD_CONFIG</key><string>/Users/YOU/switchboard/switchboard.config.json</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/switchboard.log</string>
  <key>StandardErrorPath</key><string>/tmp/switchboard.log</string>
</dict>
</plist>
