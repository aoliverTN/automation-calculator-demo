{
  "host": "0.0.0.0",
  "port": 7777,
  "authToken": "${SWITCHBOARD_TOKEN}",
  "timeoutMinutes": 60,

  "github": { "token": "${GITHUB_TOKEN}" },

  "notify": {
    "ntfy": { "server": "https://ntfy.sh", "topic": "${NTFY_TOPIC}" },
    "teams": { "webhookUrl": "${TEAMS_WEBHOOK_URL}" }
  },

  "agents": [
    {
      "id": "claude", "name": "Claude Code", "aliases": ["claude", "cloud"],
      "type": "cli", "preset": "claude-code",
      "extraArgs": ["--permission-mode", "acceptEdits"],
      "cwd": "~/code", "roles": ["coder", "chat"], "maxParallel": 2
    },
    {
      "id": "reviewer", "name": "Claude Reviewer", "aliases": ["reviewer"],
      "type": "cli", "preset": "claude-code",
      "extraArgs": ["--permission-mode", "plan"],
      "roles": ["reviewer", "ui-reviewer"], "maxParallel": 2
    },
    { "id": "codex", "name": "Codex", "type": "cli", "preset": "codex", "roles": ["coder", "chat"] },
    { "id": "gemini-cli", "name": "Gemini CLI", "aliases": ["gemini code"], "type": "cli", "preset": "gemini-cli", "roles": ["coder"] },
    { "id": "copilot", "name": "Copilot", "type": "cli", "preset": "copilot-cli", "roles": ["coder"] },

    { "id": "grok", "name": "Grok", "type": "api", "provider": "xai", "model": "grok-4", "roles": ["chat"] },
    { "id": "chatgpt", "name": "ChatGPT", "aliases": ["gpt", "openai"], "type": "api", "provider": "openai", "model": "gpt-5", "roles": ["chat"] },
    { "id": "gemini", "name": "Gemini", "type": "api", "provider": "gemini", "model": "gemini-2.5-pro", "roles": ["chat"] },
    { "id": "claude-chat", "name": "Claude Chat", "type": "api", "provider": "anthropic", "model": "claude-opus-5-5", "roles": ["chat"] }
  ],

  "queue": {
    "autoStart": false,
    "pollSeconds": 60,
    "maxFixRounds": 2,
    "repos": [
      {
        "repo": "aoliverTN/automation-calculator-demo",
        "base": "main",
        "coders": ["claude", "codex"],
        "reviewer": "reviewer",
        "uiReviewer": "reviewer",
        "test": [],
        "deploy": "rsync -az --delete --exclude .git ./ tester@testbox:/var/www/calculator/",
        "smoke": { "url": "http://testbox/", "paths": ["/"], "expectText": "ThrottleNet", "rounds": 3 }
      }
    ]
  }
}
